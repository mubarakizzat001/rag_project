APP_NAME="rag_app"
APP_VERSION="0.1"


FILE_ALLOWED_TYPE=["text/plain","application/pdf"]
FILE_MAX_SIZE=10
FILE_DEFAULT_CHUNK_SIZE=512000 #512K

MONGODB_URL=""
MONGODB_DATABASE="RAG_PROJECT"

#==================LLM config====================
GENERATION_BACKEND="OPENAI"
EMBEDDING_BACKEND="COHERE"

OPENAI_API_KEY=""
OPENAI_API_URL=
COHERE_API_KEY=""


GENERATION_MODEL_ID="GPT-3.5 Turbo"
EMBEDDING_MODEL_ID="embed-multilingual-light-v3.0"
EMBEDDING_MODEL_SIZE=384


default_input_max_charecters=1024
default_output_max_tokens=200
default_temperature=0.1
